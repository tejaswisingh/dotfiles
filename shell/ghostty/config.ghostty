# ~/.config/ghostty/config

# Use a dark theme by default, with a light fallback if your system switches
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Make the window decorations follow the desktop theme
window-theme = system

# Typography
font-family = Noto Sans Mono
font-size = 12
font-thicken = true

# Smoother appearance
background-opacity = 0.94
window-padding-x = 10
window-padding-y = 8

# Cursor and selection
cursor-style = block
cursor-style-blink = true

# Useful quality-of-life
scrollback-limit = 25000000
shell-integration = detect
mouse-hide-while-typing = true
copy-on-select = clipboard
split-divider-color = #d0afff

# Terminal Size
window-width = 120
window-height = 34

# Keybinds
keybind = ctrl+r=reload_config
keybind = ctrl+up=new_split:up
keybind = ctrl+down=new_split:down
keybind = ctrl+left=new_split:left
keybind = ctrl+right=new_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+x=close_surface

# Custom Shaders -> Shaders can be found at https://github.com/linkarzu/dotfiles-latest/tree/main/ghostty/shaders and placed in the dotfiles/shell/ghostty/shaders directory
custom-shader = shaders/bloom050.glsl
custom-shader = shaders/cursor_blaze_no_trail.glsl
custom-shader = shaders/cursor_smear.glsl
